# PNI R2C 环境配置示例
# 复制此文件为 .env 并根据需要修改
# 使用: source .env

# ============================================================================
# 编译环境配置
# ============================================================================

# C++ 编译器路径（默认: g++）
export CXX=g++

# C++ 编译标志
export CXXFLAGS="-std=c++17 -Wall -Wextra -O2"

# 链接标志
export LDFLAGS="-pthread -Llib -lgrpc++ -lgrpc -lprotobuf -lgpr -lpthread /usr/lib/x86_64-linux-gnu/libssl.so.3 /usr/lib/x86_64-linux-gnu/libcrypto.so.3 -lz"

# ============================================================================
# gRPC 配置
# ============================================================================

# gRPC 源代码路径（用于网络集成）
export GRPC_PATH="/media/ustc-pni/5282FE19AB6D5297/pni_grpc/grpc"

# gRPC 编译输出路径
export GRPC_BUILD_PATH="${GRPC_PATH}/cmake/build"

# Protocol Buffers 编译器（如果需要 protoc）
export PROTOC_PATH="${GRPC_BUILD_PATH}/../third_party/protobuf"

# gRPC C++ 插件路径
export GRPC_CPP_PLUGIN_PATH="${GRPC_BUILD_PATH}/grpc_cpp_plugin"

# ============================================================================
# 项目路径配置
# ============================================================================

# 项目根目录
export PROJECT_ROOT="."

# 编译输出目录
export BUILD_DIR="build"
export BIN_DIR="bin"

# ============================================================================
# 时钟同步配置
# ============================================================================

# 同步间隔（毫秒）
export SYNC_INTERVAL_MS=5000

# 每次同步的样本数
export NUM_SYNC_SAMPLES=5

# 样本间隔（毫秒）
export SAMPLE_INTERVAL_MS=100

# 异常值检测阈值（纳秒）
export OUTLIER_THRESHOLD_NS=50000000

# 最大时钟偏差容限（纳秒）
export MAX_CLOCK_OFFSET_NS=10000000000

# ============================================================================
# 段合并配置
# ============================================================================

# 单个输出段最大时长（毫秒）
export MAX_GROUP_DURATION_MS=60000

# 段间时间容限（纳秒）
export TIME_TOLERANCE_NS=1000000000

# ============================================================================
# 符合计算配置
# ============================================================================

# 符合时间窗口（皮秒）
export COINCIDENCE_WINDOW_PS=10000

# ============================================================================
# 调试选项
# ============================================================================

# 详细日志输出
export VERBOSE=0

# 编译时启用调试符号（仅用于调试）
# export CXXFLAGS="-std=c++17 -Wall -Wextra -g -O0"

# ============================================================================
# 使用示例
#
# 1. 加载配置:
#    source .env
#
# 2. 自定义编译:
#    make clean
#    make test CXX=$CXX CXXFLAGS="$CXXFLAGS" LDFLAGS="$LDFLAGS"
#
# 3. 验证配置:
#    echo "GCC: $CXX"
#    echo "CXXFLAGS: $CXXFLAGS"
#    echo "gRPC: $GRPC_PATH"
#
# ============================================================================
